<?xml version="1.0" encoding="UTF-8"?>
<plugin>
    <class>com.igniterealtime.openfire.plugin.moderation.ModerationPlugin</class>

    <!--
        Load-bearing, not cosmetic, twice over:
          - on unload Openfire calls SystemProperty.removePropertiesForPlugin(<name>), so
            ModerationProperties.PLUGIN must be exactly this string, or the next hot-reload dies
            with "A SystemProperty already exists with a key of ...";
          - LocaleUtils derives the i18n bundle name from it ("Message Moderation" ->
            messagemoderation_i18n), which is why the bundle has that file name.
    -->
    <name>Message Moderation</name>
    <description>XEP-0425: lets MUC moderators retract other occupants' messages for everyone.</description>
    <author>besteffortdev</author>
    <!-- Filled in from the pom at build time. Bump it in pom.xml, not here. -->
    <version>${project.version}</version>
    <date>10/04/2026</date>
    <!--
        5.0.5 is the first release this was verified against, and the first with the core pieces
        it builds on: XEP-0421 occupant-ids on every MUC stanza, XEP-0359 stanza-ids stamped by
        the room, and the MUC conversation-log Archiver it waits on before touching the archive.
    -->
    <minServerVersion>5.0.5</minServerVersion>
    <licenseType>apache</licenseType>
</plugin>
